Table "pedidos" {
  "id" bigint [pk, not null, increment]
  "user_id" bigint [not null]
  "total" decimal(10,2) [not null]
  "estado" pedidos_estado_enum [not null, default: "pendiente"]
  "created_at" timestamp [default: NULL]
  "updated_at" timestamp [default: NULL]

Indexes {
  user_id [name: "pedidos_user_id_foreign"]
}
}

Table "productos" {
  "id" bigint [pk, not null, increment]
  "nombre_comun" varchar(255) [not null]
  "nombre_cientifico" varchar(255) [not null]
  "categoria" productos_categoria_enum [not null, default: "hadal_zone"]
  "precio" decimal(10,2) [not null]
  "stock" int [not null, default: "0"]
  "descripcion" text [not null]
  "imagen_url" varchar(255) [not null]
  "estado_vida" productos_estado_vida_enum [not null, default: "ambos"]
  "created_at" timestamp [default: NULL]
  "updated_at" timestamp [default: NULL]
  "deleted_at" timestamp [default: NULL]
}

Table "reviews" {
  "id" bigint [pk, not null, increment]
  "user_id" bigint [not null]
  "rating" tinyint [not null]
  "comentario" text [not null]
  "created_at" timestamp [default: NULL]
  "updated_at" timestamp [default: NULL]
  "deleted_at" timestamp [default: NULL]

Indexes {
  user_id [name: "reviews_user_id_foreign"]
}
}

// Table "sessions" {
//   "id" varchar(255) [pk, not null]
//   "user_id" bigint [default: NULL]
//   "ip_address" varchar(45) [default: NULL]
//   "user_agent" text
//   "payload" longtext [not null]
//   "last_activity" int [not null]

// Indexes {
//   user_id [name: "sessions_user_id_index"]
//   last_activity [name: "sessions_last_activity_index"]
// }
// }

Table "users" {
  "id" bigint [pk, not null, increment]
  "name" varchar(255) [not null]
  "email" varchar(255) [not null]
  "avatar" varchar(255) [default: NULL]
  "rol" users_rol_enum [not null, default: "cliente"]
  "email_verified_at" timestamp [default: NULL]
  "password" varchar(255) [not null]
  "remember_token" varchar(100) [default: NULL]
  "created_at" timestamp [default: NULL]
  "updated_at" timestamp [default: NULL]
  "deleted_at" timestamp [default: NULL]

Indexes {
  email [unique, name: "users_email_unique"]
}
}

// Relaciones entre tablas

Ref:"users"."id" < "carritos"."user_id" [delete: cascade]

Ref:"productos"."id" < "carritos"."producto_id" [delete: cascade]

Ref:"pedidos"."id" < "detalle_pedidos"."pedido_id" [delete: cascade]

Ref:"productos"."id" < "detalle_pedidos"."producto_id" [delete: set null]

Ref:"users"."id" < "favoritos"."user_id" [delete: cascade]

Ref:"productos"."id" < "favoritos"."producto_id" [delete: cascade]

Ref:"users"."id" < "pedidos"."user_id" [delete: cascade]

Ref:"users"."id" < "reviews"."user_id" [delete: cascade]
