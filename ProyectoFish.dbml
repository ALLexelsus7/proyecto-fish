Enum "carritos_tipo_compra_enum" {
  "consumo"
  "ornamental"
}

Enum "detalle_pedidos_tipo_compra_enum" {
  "consumo"
  "ornamental"
}

Enum "pedidos_estado_enum" {
  "pendiente"
  "enviado"
  "entregado"
  "cancelado"
}

Enum "productos_categoria_enum" {
  "shallow_coastal"
  "oceanic"
  "hadal_zone"
}

Enum "productos_estado_vida_enum" {
  "ambos"
  "vivo"
  "consumo"
}

Enum "users_rol_enum" {
  "cliente"
  "admin"
}

