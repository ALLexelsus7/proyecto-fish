Table "carritos" {
  "id" bigint [pk, not null, increment]
  "user_id" bigint [not null]
  "producto_id" bigint [not null]
  "cantidad" int [not null, default: "1"]
  "tipo_compra" carritos_tipo_compra_enum [not null, default: "ornamental"]
  "created_at" timestamp [default: NULL]
  "updated_at" timestamp [default: NULL]

Indexes {
  user_id [name: "carritos_user_id_foreign"]
  producto_id [name: "carritos_producto_id_foreign"]
}
}

Table "contact_messages" {
  "id" bigint [pk, not null, increment]
  "nombre" varchar(255) [not null]
  "email" varchar(255) [not null]
  "asunto" varchar(255) [not null]
  "mensaje" text [not null]
  "leido" tinyint(1) [not null, default: "0"]
  "created_at" timestamp [default: NULL]
  "updated_at" timestamp [default: NULL]
}

Table "detalle_pedidos" {
  "id" bigint [pk, not null, increment]
  "pedido_id" bigint [not null]
  "producto_id" bigint [default: NULL]
  "cantidad" int [not null]
  "precio_unitario" decimal(10,2) [not null]
  "tipo_compra" detalle_pedidos_tipo_compra_enum [not null]
  "created_at" timestamp [default: NULL]
  "updated_at" timestamp [default: NULL]

Indexes {
  pedido_id [name: "detalle_pedidos_pedido_id_foreign"]
  producto_id [name: "detalle_pedidos_producto_id_foreign"]
}
}

